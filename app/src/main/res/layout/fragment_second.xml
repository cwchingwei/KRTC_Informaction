<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".SecondFragment">

    <!-- 提示文字 -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="點擊下方按鈕開啟 Google Maps"
        android:textSize="18sp"
        android:textColor="@color/gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"/>

    <!-- 卡片顯示車站資訊 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_station_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:padding="16dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- 車站名稱 -->
            <TextView
                android:id="@+id/textview_station_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:text="車站名稱"
                android:paddingBottom="8dp"/>

            <!-- 經緯度資訊 -->
            <TextView
                android:id="@+id/textview_coordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/gray"
                android:text="緯度: 22.6273, 經度: 120.3014"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 開啟 Google Maps 按鈕 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_map"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="開啟 Google Maps"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/card_station_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- 返回按鈕 -->
    <Button
        android:id="@+id/button_second"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="返回"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_open_map"
        android:layout_marginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
